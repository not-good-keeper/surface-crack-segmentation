# --- secrets: never commit ---
.kaggle/
kaggle.json
access_token
*.token
.env
*.pem
.roboflow/
api_key
roboflow.json

# Agent tool settings. Excluded because it is a credential file in practice, not
# just an editor preference: the permission allow-list records literal commands,
# and this one contained a Kaggle access token in plaintext. Anything that logs
# the commands a session ran is a secret-bearing file.
.claude/

# --- environments ---
.venv/
# The interface runs on Python 3.13 (pydantic-settings and datetime.UTC need 3.11+),
# the training stack stays on the 3.9 venv with torch. Two environments, both ignored.
.venv-app/
__pycache__/
*.pyc

# ---------------------------------------------------------------------------
# Data policy: bulk stays on disk, provenance goes in git.
#
# Everything under data/ is regenerable from `dataset/` given the sources in
# dataset/sources.yaml -- index -> normalize -> split -> qa. What must be in git is
# whatever makes that regeneration deterministic and auditable: the split definition,
# its hash, and the manifests. Committing the images themselves would push a licence
# problem into the repo as well as gigabytes: the corpus mixes CC0, CC-BY, CC-BY-NC
# and research-only terms, and several sources forbid redistribution outright.
# ---------------------------------------------------------------------------
data/*
!data/manifest.csv
!data/manifest_clean.csv
!data/manifest_split.csv
!data/splits.json
!data/backgrounds.csv
!data/wood_yield.csv
!data/index_audit.txt

# ---------------------------------------------------------------------------
# Phase 2 demo bundle: committed on purpose, unlike everything else under data/.
#
# The deployment is built from git, so anything the mock deployment needs at runtime
# has to be in the repository — there is no build step that could fetch it, and the
# serverless filesystem is read-only. That is the whole bundle: the seeded database,
# the generated surfaces and overlays, the batch folders and the coverage metrics,
# about 28 MB. It is all procedurally generated by scripts/build_demo_bundle.py, so
# none of it carries the licence problem the training corpus does.
#
# git cannot re-include a file whose parent directory is excluded, so each directory
# on the path is re-included before its contents are filtered.
# ---------------------------------------------------------------------------
!data/inspection.db
!data/metrics/
!data/batches/
!data/sources/
data/sources/*
!data/sources/mock/
!data/overlays/
data/overlays/*
!data/overlays/mock/

# Written by real-mode inspections on this machine. Real output is evidence about
# whatever was photographed here; it is not part of the demo and must not ship.
data/sources/real/
data/overlays/real/
data/exports/

# Benchmark RESULTS are evidence and belong in git; benchmark WEIGHTS do not.
# 23 checkpoints is 139 MB, and the .json next to each one already records the
# metrics, the args and the split hash that produced it.
!data/bench/
data/bench/*.pt
data/bench/*.onnx

# Superseded manifests: kept on disk for comparison, not in the first commit.
data/manifest_split_v1.csv
data/manifest_split_v4.csv

