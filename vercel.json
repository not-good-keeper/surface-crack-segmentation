{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "runtime": "python3.12",
        "maxLambdaSize": "250mb",
        "includeFiles": "{app/templates/**,app/static/**,data/metrics/**,data/inspection.db,data/sources/mock/**,data/overlays/mock/**,data/batches/**}"
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "api/index.py" }
  ],
  "env": {
    "INSPECTION_PROVIDER": "mock",
    "DEMO_MODE": "true",
    "SERVERLESS": "true",
    "APP_ENV": "production",
    "MOCK_SEED": "404"
  }
}
