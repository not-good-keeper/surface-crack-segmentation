# The Docker build context should be the code and the model, not the training corpus.
# data/ alone can hold tens of GB of checkpoints and source imagery locally (see the
# note in .gitignore); the image generates its own demo history at build time via
# scripts/seed_db.py. Two things it cannot generate and must receive: the metrics file
# and the exported ONNX graph.
data/
!data/metrics/
!data/metrics/coverage.json
!data/export/
!data/export/model.onnx

.venv/
.venv-app/
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/

.git/
.github/

# Defence in depth: the Dockerfile never copies this (no COPY . . anywhere), but if
# that ever changes, a local secret must still never reach the image.
.env
*.env
!.env.example

bench/
dataset/
defectforge/
experiments/
docs/screenshots/

tests/
*.md
*.pdf

Dockerfile
.dockerignore
docker-compose.yml

# The PyTorch checkpoint is the export INPUT, not a runtime artefact. The container
# serves data/export/model.onnx; shipping the 5.9 MB .pt as well would grow the build
# context for a file nothing in the image opens.
*.pt
